# Copy to backend/.env for local development.
DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5433/court_booking
TEST_DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5433/court_booking_test
# Required. Generate one with: openssl rand -hex 32
JWT_SECRET_KEY=
# Outgoing mail; the defaults point at the Mailpit container (UI on http://localhost:8025).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# MAIL_FROM="Court Booking <no-reply@courtbooking.local>"
