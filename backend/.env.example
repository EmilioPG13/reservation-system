# Copy to .env (git-ignored). Every value here has a development default except JWT_SECRET_KEY.

# Required. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=

# DATABASE_URL=postgresql+asyncpg://booking:booking@localhost:5433/court_booking
# Behind a transaction-mode pooler (Neon's -pooler host) set DATABASE_POOLED=true and give
# migrations the direct connection. Provider strings work as copied (postgresql://, sslmode):
# DATABASE_POOLED=true
# MIGRATION_DATABASE_URL=postgresql://...direct-host.../db?sslmode=require

# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_START_TLS=false
# MAIL_FROM="Court Booking <no-reply@courtbooking.local>"

# Origin of a separately hosted frontend, comma-separated. Empty when the SPA proxies /api.
# CORS_ORIGINS=https://your-frontend.example

# Abuse limits (0 = unlimited)
# MAX_USERS=300
# AUTH_ATTEMPTS_PER_MINUTE=10
